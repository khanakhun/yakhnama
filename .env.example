# Yakhnama local environment. Copy to `.env` and adjust.
# DEVELOPMENT-ONLY VALUES. Real secrets never go in this file or in any committed file;
# production configuration comes from the deployment environment.

# --- Application settings (read by src/yakhnama/platform/settings.py) ---------------
# Application name shown in the OpenAPI document.
YAKHNAMA_APP_NAME=Yakhnama
# Deployment environment: development | test | production.
YAKHNAMA_ENVIRONMENT=development
# Minimum log level: DEBUG | INFO | WARNING | ERROR.
YAKHNAMA_LOG_LEVEL=INFO
# Log output: json (machine-readable) | console (human-readable).
YAKHNAMA_LOG_FORMAT=json
# CORS origins as a JSON list, e.g. ["http://localhost:3000"]; empty list allows none.
YAKHNAMA_CORS_ALLOW_ORIGINS=[]
# Decimals kept on public coordinates (0-6); final value is a maintainer decision.
YAKHNAMA_PUBLIC_COORDINATE_DECIMALS=2

# --- docker compose services (read only by docker-compose.yml) -----------------------
POSTGRES_USER=yakhnama
POSTGRES_PASSWORD=yakhnama-dev-only
POSTGRES_DB=yakhnama
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-dev-only
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-only

# Host ports the compose services bind on 127.0.0.1. Change them when a local
# PostgreSQL, Redis or another service already uses the default port.
POSTGRES_HOST_PORT=5432
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
KEYCLOAK_HOST_PORT=8080
REDIS_HOST_PORT=6379
