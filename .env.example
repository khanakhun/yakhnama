# Yakhnama local environment. Copy to `.env` and adjust.
# DEVELOPMENT-ONLY VALUES. Real secrets never go in this file or in any committed file;
# production configuration comes from the deployment environment.

# --- Application settings (read by src/yakhnama/platform/settings.py) ---------------
# Application name shown in the OpenAPI document.
YAKHNAMA_APP_NAME=Yakhnama
# Deployment environment: development | test | production. Always set it: when it is
# missing the API starts as development and logs an "environment_defaulted" warning.
# production enforces the guard in platform/settings.py (no docs, JSON logs, OIDC,
# Redis rate limiting and task queue, explicit https CORS origins, a real database URL).
YAKHNAMA_ENVIRONMENT=development
# Minimum log level: DEBUG | INFO | WARNING | ERROR.
YAKHNAMA_LOG_LEVEL=INFO
# Log output: json (machine-readable) | console (human-readable).
YAKHNAMA_LOG_FORMAT=json
# CORS origins as a JSON list, e.g. ["http://localhost:3000"]; empty list allows none.
YAKHNAMA_CORS_ALLOW_ORIGINS=[]
# Decimals kept on public coordinates (0-6); final value is a maintainer decision.
YAKHNAMA_PUBLIC_COORDINATE_DECIMALS=2
# Serve the OpenAPI document and the Scalar API reference at /api/v1/docs: true |
# false. Must be false in production.
YAKHNAMA_DOCS_ENABLED=true
# Where browsers load the Scalar bundle from (https, or http on localhost only). The
# default is the jsDelivr CDN; point it at a self-hosted copy to avoid the CDN
# (ADR 0014).
YAKHNAMA_DOCS_SCALAR_JS_URL=https://cdn.jsdelivr.net/npm/@scalar/api-reference

# --- HTTP hardening --------------------------------------------------------------------
# Host header values the API answers, as a JSON list; "*.example.org" allows
# subdomains. "testserver" and "test" are the in-process test clients' hosts.
YAKHNAMA_TRUSTED_HOSTS=["localhost", "127.0.0.1", "::1", "testserver", "test"]
# Largest accepted request body in bytes (1024-67108864); larger bodies get 413.
YAKHNAMA_MAX_REQUEST_BODY_BYTES=1048576
# Header carrying the request id in and out; also the Problem Details "instance".
YAKHNAMA_REQUEST_ID_HEADER=X-Request-ID

# --- Authentication (OpenID Connect, ADR 0005 and 0015) -----------------------------
# Identity provider issuer, compared exactly against every token's "iss" claim (ADR
# 0005). Must match what Keycloak actually puts in "iss" for the callers that reach the
# backend, which depends on the host and port used to reach Keycloak, not a fixed value
# (see docs/architecture/auth.md, "the exact-issuer pitfall"). https is required except
# on localhost. Empty (the default) disables bearer authentication: protected routes
# answer 401. For the local realm at the default KEYCLOAK_HOST_PORT, set
# YAKHNAMA_OIDC_ISSUER=http://127.0.0.1:8080/realms/yakhnama in your .env.
YAKHNAMA_OIDC_ISSUER=
# Expected "aud" claim on every access token; matches the yakhnama-api client id in
# docker/keycloak/yakhnama-realm.json.
YAKHNAMA_OIDC_AUDIENCE=yakhnama-api
# JWKS endpoint; empty means discover it from <issuer>/.well-known/openid-configuration.
YAKHNAMA_OIDC_JWKS_URL=
# Accepted signing algorithms as a JSON list: RS256 and/or ES256 (nothing else).
YAKHNAMA_OIDC_ALLOWED_ALGORITHMS=["RS256"]
# The one dotted claim path realm roles are read from; no other claim grants a role.
YAKHNAMA_OIDC_ROLES_CLAIM=realm_access.roles
# JOSE typ header values a token may carry, as a JSON list (case-insensitive).
YAKHNAMA_OIDC_ACCEPTED_TOKEN_TYPES=["JWT","at+jwt"]
# Clock skew tolerated on exp, nbf and iat, in seconds (0-60).
YAKHNAMA_OIDC_LEEWAY_SECONDS=10
# Timeout of each discovery or JWKS request, in seconds (0.5-30).
YAKHNAMA_OIDC_HTTP_TIMEOUT_SECONDS=5.0
# How long fetched signing keys are trusted before a refetch, in seconds (60-86400).
YAKHNAMA_JWKS_CACHE_TTL_SECONDS=600

# --- Idempotency and rate limiting (ADR 0016 and 0017) ------------------------------
# Hours a stored Idempotency-Key response is replayed (1-168).
YAKHNAMA_IDEMPOTENCY_TTL_HOURS=72
# Apply per-client rate limits: true | false. Must be true in production.
YAKHNAMA_RATE_LIMIT_ENABLED=true
# memory (one process; development and tests) | redis (shared; required in
# production).
YAKHNAMA_RATE_LIMIT_BACKEND=memory
# Redis DSN for the redis backend, e.g. redis://127.0.0.1:6379/0 (the port is
# REDIS_HOST_PORT); empty means none.
YAKHNAMA_REDIS_URL=
# Connect and read timeout of each Redis call in seconds (0.05-5); on a timeout the
# rate limiter lets the request through and logs a warning.
YAKHNAMA_REDIS_SOCKET_TIMEOUT_SECONDS=0.25
# Requests per minute per client IP without a valid token (1-100000).
YAKHNAMA_RATE_LIMIT_ANONYMOUS_PER_MINUTE=60
# Requests per minute per authenticated principal (1-100000).
YAKHNAMA_RATE_LIMIT_AUTHENTICATED_PER_MINUTE=300

# --- Background tasks and the outbox relay (ADR 0007 and 0008) ---------------------
# All values below are proposed operational defaults awaiting maintainer review.
# memory (tasks run inside the process that enqueues them; development and tests) |
# redis (a Redis stream consumed by `poe worker`; needs YAKHNAMA_REDIS_URL; required in
# production). Run `poe worker` and exactly one `poe scheduler` with redis.
YAKHNAMA_TASK_QUEUE_BACKEND=memory
# Seconds between two scheduled outbox relay runs (1-60).
YAKHNAMA_OUTBOX_RELAY_INTERVAL_SECONDS=5
# Outbox messages claimed per relay run (1-1000).
YAKHNAMA_OUTBOX_BATCH_SIZE=100
# Delivery attempts before a message is dead-lettered (1-100).
YAKHNAMA_OUTBOX_MAX_ATTEMPTS=5
# Seconds a claimed message stays reserved for its relay (5-3600); at least the
# subscriber timeout below.
YAKHNAMA_OUTBOX_LEASE_SECONDS=120
# Seconds one subscriber call may take before it is cancelled and counted as a
# failed attempt (1-300).
YAKHNAMA_OUTBOX_SUBSCRIBER_TIMEOUT_SECONDS=30
# Days a published outbox message is kept before the daily purge deletes it (1-365).
# Pending and dead-lettered messages are never purged.
YAKHNAMA_OUTBOX_RETENTION_DAYS=30
# Minutes between two purges of expired Idempotency-Key records (5-1440).
YAKHNAMA_IDEMPOTENCY_PURGE_INTERVAL_MINUTES=60

# --- Database ------------------------------------------------------------------------
# PostgreSQL DSN; must use the postgresql+asyncpg driver. User, password and database
# match the POSTGRES_* values below, and the port must match POSTGRES_HOST_PORT.
YAKHNAMA_DATABASE_URL=postgresql+asyncpg://yakhnama:yakhnama-dev-only@127.0.0.1:5432/yakhnama
# Connections kept in the engine pool (1-64).
YAKHNAMA_DATABASE_POOL_SIZE=5
# Log every SQL statement (parameters are always hidden): true | false.
YAKHNAMA_DATABASE_ECHO=false
# Upper bound in seconds for each /health/ready check (0.1-30).
YAKHNAMA_HEALTH_READY_TIMEOUT_SECONDS=2.0

# --- Reference-data seed (python -m yakhnama.seed, poe seed) ------------------------
# Directory with the versioned reference YAML files; relative to the working directory.
YAKHNAMA_REFERENCE_DATA_DIR=data/reference
# UUIDv7 of the system actor the seed records on its changes. Empty means the seed
# generates a new system actor per run and logs its id (Phase 1 placeholder; Phase 2
# replaces it with a real identity).
YAKHNAMA_SEED_ACTOR_ID=

# --- Telemetry (OpenTelemetry tracing) -------------------------------------------------
# Turn tracing on: true | false.
YAKHNAMA_OTEL_ENABLED=false
# Span exporter: none | console | otlp (otlp needs opentelemetry-exporter-otlp, not
# installed yet).
YAKHNAMA_OTEL_EXPORTER=none
# Collector endpoint for the otlp exporter; empty means none.
YAKHNAMA_OTEL_EXPORTER_ENDPOINT=
# service.name resource attribute on every span.
YAKHNAMA_OTEL_SERVICE_NAME=yakhnama

# --- Media object storage (ADR 0009) ----------------------------------------------
# S3-compatible endpoint; https except on a loopback host. Empty means AWS's regional
# default. The development values match the minio service below; production refuses
# the development secret.
YAKHNAMA_STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
# Region requests are signed for.
YAKHNAMA_STORAGE_REGION=us-east-1
YAKHNAMA_STORAGE_ACCESS_KEY_ID=minioadmin
YAKHNAMA_STORAGE_SECRET_ACCESS_KEY=minioadmin-dev-only
# Private originals and metadata-stripped public copies; the two must differ.
YAKHNAMA_STORAGE_PRIVATE_BUCKET=yakhnama-media-private
YAKHNAMA_STORAGE_PUBLIC_BUCKET=yakhnama-media-public
# Lifetime in seconds of every presigned upload and download URL (60-3600).
YAKHNAMA_STORAGE_PRESIGN_TTL_SECONDS=900

# --- Malware scanning of uploads --------------------------------------------------------
# noop | clamav. noop scans nothing, logs a warning at startup and is refused in
# production; clamav streams each upload to clamd (set its StreamMaxLength to at
# least 50M).
YAKHNAMA_MALWARE_SCANNER=noop
# clamd host (required for clamav), TCP port and the upper bound in seconds for one
# scan (1-600).
YAKHNAMA_CLAMAV_HOST=
YAKHNAMA_CLAMAV_PORT=3310
YAKHNAMA_CLAMAV_TIMEOUT_SECONDS=60

# --- docker compose services (read only by docker-compose.yml) -----------------------
POSTGRES_USER=yakhnama
POSTGRES_PASSWORD=yakhnama-dev-only
POSTGRES_DB=yakhnama
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-dev-only
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-only

# Host ports the compose services bind on 127.0.0.1. Change them when a local
# PostgreSQL, Redis or another service already uses the default port.
POSTGRES_HOST_PORT=5432
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
KEYCLOAK_HOST_PORT=8080
REDIS_HOST_PORT=6379
