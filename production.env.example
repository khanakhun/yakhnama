# Yakhnama production environment for docker-compose.production.yml (ADR 0023).
#
#   cp production.env.example .env.production     # git-ignored; chmod 600 it
#   docker compose -f docker-compose.production.yml --env-file .env.production up -d
#
# This file holds placeholders only. Replace every `change-me` with a generated value
# and every example.org name with the real one; never commit the filled-in copy.
# Generate secrets on the server, one per line, and never reuse one for two purposes:
#
#   passwords and keys:     openssl rand -hex 32
#   guest challenge secret: openssl rand -base64 48 | tr '+/' '-_' | tr -d '=\n'
#
# Hex keeps the values safe inside the URLs built below (no '+', '/', '@' or ':').
# Values may refer to variables defined above them with ${NAME}; docker compose
# expands them when it reads this file.
#
# The application refuses to start in production unless (platform/settings.py,
# production_problems): the database URL, the storage key and secret and the guest
# challenge secret are not the development ones; the guest secret is URL-safe base64
# of at least 32 random bytes and differs from every other secret; docs are off; logs
# are JSON and not DEBUG; SQL echo is off; OIDC is set and https; rate limiting is on
# and on Redis; the task queue is Redis; the scanner is not noop; the storage endpoint
# is https; CORS holds only https origins; trusted hosts hold no '*' and no test host;
# the guest proof of work is at least 18 bits. tests/unit/platform/
# test_production_env_example.py checks that this file passes once filled in.

# --- Public names (the host's reverse proxy terminates TLS for them) -------------------
# The portal's origin: the only origin allowed to PUT photos to presigned URLs
# (MinIO CORS) and the one the production realm registers (README "Production").
PORTAL_ORIGIN=https://example.org
# Keycloak: the issuer of every token is https://${KEYCLOAK_PUBLIC_HOST}/realms/yakhnama.
KEYCLOAK_PUBLIC_HOST=auth.example.org
# MinIO's S3 API: the host of every presigned upload and download URL.
STORAGE_PUBLIC_HOST=files.example.org
# Where the containers reach the host's reverse proxy for the two names above.
# host-gateway is the host itself; set the server's public address instead if the
# proxy listens only there.
REVERSE_PROXY_ADDRESS=host-gateway

# --- Host ports, bound to 127.0.0.1 only ---------------------------------------------
# The portal's YAKHNAMA_API_URL is http://127.0.0.1:${API_HOST_PORT}.
API_HOST_PORT=8000
KEYCLOAK_HOST_PORT=8180
MINIO_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101
# The MinIO web console on MINIO_CONSOLE_HOST_PORT: on | off.
MINIO_CONSOLE=on

# --- Images and process counts -------------------------------------------------------
# Tags `docker compose build` gives the two images, or the registry images to run.
API_IMAGE=yakhnama-api:local
KEYCLOAK_IMAGE=yakhnama-keycloak:local
# uvicorn worker processes of the API (about 150 MB each).
WEB_CONCURRENCY=2
# Taskiq worker processes (about 200 MB each).
TASKIQ_WORKERS=1

# --- PostgreSQL (one cluster, two databases) ------------------------------------------
POSTGRES_USER=yakhnama
POSTGRES_PASSWORD=change-me
POSTGRES_DB=yakhnama
# Created by docker/keycloak/production/postgres-init/010-keycloak-database.sh when the
# data volume is first initialised.
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me

# --- Redis (task queue and rate-limit counters; never published) ----------------------
REDIS_PASSWORD=change-me

# --- MinIO -----------------------------------------------------------------------------
# Root credentials: used only by minio-init and the console, never by the application.
MINIO_ROOT_USER=yakhnama-root
MINIO_ROOT_PASSWORD=change-me

# --- Keycloak --------------------------------------------------------------------------
# Temporary admin of the master realm, created on the first start only. Sign in through
# the SSH tunnel, create a permanent admin, then delete this one (README "Production").
KEYCLOAK_ADMIN_USER=bootstrap-admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Directory holding yakhnama-realm.json, the production realm imported on first start
# (docker/keycloak/production/README.md); git-ignored.
KEYCLOAK_REALM_IMPORT_DIR=./docker/keycloak/production/import
# Transactional SMTP relay for verification and password-reset mail (open question
# Q213). Read only when the realm is imported; afterwards change it in the console.
KC_SMTP_HOST=smtp.example.net
KC_SMTP_PORT=587
KC_SMTP_FROM=no-reply@example.org
KC_SMTP_FROM_DISPLAY_NAME=Yakhnama
KC_SMTP_USER=change-me
KC_SMTP_PASSWORD=change-me
# Social sign-in stays off until the project owns the apps (Q214, Q215).
KC_GOOGLE_ENABLED=false
KC_GOOGLE_CLIENT_ID=
KC_GOOGLE_CLIENT_SECRET=
KC_FACEBOOK_ENABLED=false
KC_FACEBOOK_CLIENT_ID=
KC_FACEBOOK_CLIENT_SECRET=

# --- Application (YAKHNAMA_*, platform/settings.py; .env.example explains each) -------
YAKHNAMA_APP_NAME=Yakhnama
YAKHNAMA_ENVIRONMENT=production
YAKHNAMA_LOG_LEVEL=INFO
YAKHNAMA_LOG_FORMAT=json
# Empty: the portal calls the API from its server, where CORS does not apply (Q212).
YAKHNAMA_CORS_ALLOW_ORIGINS=[]
YAKHNAMA_PUBLIC_COORDINATE_DECIMALS=2
YAKHNAMA_DOCS_ENABLED=false
YAKHNAMA_DOCS_SCALAR_JS_URL=https://cdn.jsdelivr.net/npm/@scalar/api-reference

# HTTP hardening. Only the portal's server (and the container healthcheck) call the
# API, as http://127.0.0.1:${API_HOST_PORT}.
YAKHNAMA_TRUSTED_HOSTS=["127.0.0.1","localhost"]
YAKHNAMA_MAX_REQUEST_BODY_BYTES=1048576
YAKHNAMA_REQUEST_ID_HEADER=X-Request-ID

# Authentication. The issuer must equal Keycloak's KC_HOSTNAME plus /realms/yakhnama,
# and the portal's OIDC_ISSUER, character for character.
YAKHNAMA_OIDC_ISSUER=https://${KEYCLOAK_PUBLIC_HOST}/realms/yakhnama
YAKHNAMA_OIDC_AUDIENCE=yakhnama-api
# Empty: discovered from the issuer (https, through the reverse proxy).
YAKHNAMA_OIDC_JWKS_URL=
YAKHNAMA_OIDC_ALLOWED_ALGORITHMS=["RS256"]
YAKHNAMA_OIDC_ROLES_CLAIM=realm_access.roles
YAKHNAMA_OIDC_ACCEPTED_TOKEN_TYPES=["JWT","at+jwt"]
YAKHNAMA_OIDC_LEEWAY_SECONDS=10
YAKHNAMA_OIDC_HTTP_TIMEOUT_SECONDS=5.0
YAKHNAMA_JWKS_CACHE_TTL_SECONDS=600

# Idempotency, rate limiting and Redis.
YAKHNAMA_IDEMPOTENCY_TTL_HOURS=72
YAKHNAMA_RATE_LIMIT_ENABLED=true
YAKHNAMA_RATE_LIMIT_BACKEND=redis
YAKHNAMA_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
YAKHNAMA_REDIS_SOCKET_TIMEOUT_SECONDS=0.25
# Every anonymous request arrives from the portal's server, so all anonymous visitors
# share this one bucket: proposed 3000 a minute until the backend can tell visitors
# apart (open question Q260). Signed-in people have one bucket each.
YAKHNAMA_RATE_LIMIT_ANONYMOUS_PER_MINUTE=3000
YAKHNAMA_RATE_LIMIT_AUTHENTICATED_PER_MINUTE=300

# Background tasks.
YAKHNAMA_TASK_QUEUE_BACKEND=redis
YAKHNAMA_OUTBOX_RELAY_INTERVAL_SECONDS=5
YAKHNAMA_OUTBOX_BATCH_SIZE=100
YAKHNAMA_OUTBOX_MAX_ATTEMPTS=5
YAKHNAMA_OUTBOX_LEASE_SECONDS=120
YAKHNAMA_OUTBOX_SUBSCRIBER_TIMEOUT_SECONDS=30
YAKHNAMA_OUTBOX_RETENTION_DAYS=30
YAKHNAMA_IDEMPOTENCY_PURGE_INTERVAL_MINUTES=60

# Database: the compose service `postgres`.
YAKHNAMA_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
YAKHNAMA_DATABASE_POOL_SIZE=5
YAKHNAMA_DATABASE_ECHO=false
YAKHNAMA_HEALTH_READY_TIMEOUT_SECONDS=2.0

# Seed and boundary load (paths inside the image).
YAKHNAMA_REFERENCE_DATA_DIR=data/reference
YAKHNAMA_INGESTION_FIXTURES_DIR=data/fixtures/ingestion
YAKHNAMA_BOUNDARY_SOURCE_FILE=data/boundaries/cod_ab_pak_gb_districts.yaml
YAKHNAMA_BOUNDARY_CACHE_DIR=.cache/boundaries
YAKHNAMA_SEED_ACTOR_ID=

# Telemetry: off until a collector exists.
YAKHNAMA_OTEL_ENABLED=false
YAKHNAMA_OTEL_EXPORTER=none
YAKHNAMA_OTEL_EXPORTER_ENDPOINT=
YAKHNAMA_OTEL_SERVICE_NAME=yakhnama

# Object storage: MinIO through its public https name, the one endpoint the backend
# has for its own calls and for presigned URLs (open question Q120). The key is the
# application user minio-init creates, not the root user.
YAKHNAMA_STORAGE_ENDPOINT_URL=https://${STORAGE_PUBLIC_HOST}
YAKHNAMA_STORAGE_REGION=us-east-1
YAKHNAMA_STORAGE_ACCESS_KEY_ID=yakhnama-app
YAKHNAMA_STORAGE_SECRET_ACCESS_KEY=change-me
YAKHNAMA_STORAGE_PRIVATE_BUCKET=yakhnama-media-private
YAKHNAMA_STORAGE_PUBLIC_BUCKET=yakhnama-media-public
YAKHNAMA_STORAGE_PRESIGN_TTL_SECONDS=900

# Malware scanning: the compose service `clamav`.
YAKHNAMA_MALWARE_SCANNER=clamav
YAKHNAMA_CLAMAV_HOST=clamav
YAKHNAMA_CLAMAV_PORT=3310
YAKHNAMA_CLAMAV_TIMEOUT_SECONDS=60

# Guest reporting (ADR 0020). The secret: see the command at the top of this file.
YAKHNAMA_GUEST_CHALLENGE_SECRET=change-me
YAKHNAMA_GUEST_POW_DIFFICULTY_BITS=18
YAKHNAMA_GUEST_POW_DIFFICULTY_MAX_BITS=22
YAKHNAMA_GUEST_POW_DIFFICULTY_STEP=200
YAKHNAMA_GUEST_CHALLENGE_TTL_SECONDS=600
YAKHNAMA_GUEST_CAPABILITY_TTL_SECONDS=1800
YAKHNAMA_GUEST_SUBMISSIONS_PER_HOUR=2000
YAKHNAMA_GUEST_REPORTS_PER_HOUR=200
YAKHNAMA_GUEST_RECEIPT_GRACE_SECONDS=86400
YAKHNAMA_GUEST_UPLOAD_PRESIGN_TTL_SECONDS=300
YAKHNAMA_GUEST_PURGE_INTERVAL_SECONDS=900

# Abandoned uploads.
YAKHNAMA_MEDIA_UPLOAD_SWEEP_AFTER_SECONDS=7200
YAKHNAMA_MEDIA_UPLOAD_SWEEP_INTERVAL_SECONDS=900
